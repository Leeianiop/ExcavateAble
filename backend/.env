# 3D Scanning Backend — Environment Template
# Copy to `.env` and adjust for your deployment.

# --- FastAPI ---
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# --- Redis / Celery ---
# Local dev: use localhost (app falls back to in-memory if Redis isn't running).
# Docker: docker-compose.yml overrides these to redis:6379 automatically.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage / job store backends ---
# "auto"  = try MinIO/Redis, fall back to FS/in-memory (slow if services down)
# "fs"    = always use local filesystem (skip MinIO) — best for local dev
# "memory"= always use in-memory job store (skip Redis) — best for local dev
STORAGE_BACKEND=fs
JOB_STORE_BACKEND=memory

# --- MinIO (object storage for bundles + assets) ---
# Only used when STORAGE_BACKEND=auto or minio.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUNDLE_BUCKET=scan-bundles
MINIO_ASSET_BUCKET=scan-assets

# --- Worker concurrency / paths ---
WORKER_CONCURRENCY=2
TEMP_DIR=./data/tmp
MAX_UPLOAD_SIZE_MB=8192
BUNDLE_TTL_DAYS=30

# --- COLMAP / OpenMVS binaries (production only) ---
COLMAP_BIN=colmap
OPENMVS_DIR=/usr/local/bin/OpenMVS
GLB_TEXTURE_SIZE=4096
PLY_DECIMATE_TARGET_RATIO=0.5
