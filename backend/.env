# 3D Scanning Backend — Environment Template
# Copy to `.env` and adjust for your deployment.

# --- FastAPI ---
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO (object storage for bundles + assets) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUNDLE_BUCKET=scan-bundles
MINIO_ASSET_BUCKET=scan-assets

# --- Worker concurrency / paths ---
WORKER_CONCURRENCY=2
TEMP_DIR=./data/tmp
MAX_UPLOAD_SIZE_MB=8192
BUNDLE_TTL_DAYS=30

# --- COLMAP / OpenMVS binaries (production only) ---
COLMAP_BIN=colmap
OPENMVS_DIR=/usr/local/bin/OpenMVS
GLB_TEXTURE_SIZE=4096
PLY_DECIMATE_TARGET_RATIO=0.5
